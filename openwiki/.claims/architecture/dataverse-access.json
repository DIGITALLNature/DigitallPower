    {
      "id": "claim_3e639cbfd54f41068c35c93b7a61479a",
      "statement": "`XrmConnection` is registered as `IXrmConnection`, and the application's shared `IOrganizationService` is resolved by synchronously invoking `IXrmConnection.ConnectAsync`, making it the common connection boundary for commands that request that service.",
      "evidence": [
        {
          "resource": "repo://src/dgt.power/Program.cs#L130-L151",
          "version": "repo-lines-v1:sha256:b90bb070b50f3a96c5bdc6966576a70c319cdf059087a79e8f06377d638567f5:"
        }
      ]
    },
    {
      "id": "claim_0e26f851fc2d4f5aa6256611f47d93ce",
      "statement": "`ConnectAsync` gives a non-empty `xrm` configuration section precedence over a named `profile` and then the persisted current identity; it throws `MissingConnectionException` when none is available. Named profiles are loaded and made current in memory before connecting.",
      "evidence": [
        {
          "resource": "repo://src/dgt.power.common/Logic/XrmConnection.cs#L15-L37",
          "version": "repo-lines-v1:sha256:26b5b591865b60404125d244e99b2eb4867b5b4bf1d18385ff1a4bcc33f58f53:"
