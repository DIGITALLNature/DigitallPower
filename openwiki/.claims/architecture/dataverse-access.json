        }
      ]
    },
    {
      "id": "claim_318d63b9a96a44bdb1070c059706b966",
      "statement": "For stored identities, `XrmConnection` selects `TokenConnector`, `AzurePipelinesConnector`, or `CrmConnector` by identity type, creates a service proxy, and probes it with `WhoAmI`; exceptions from those operations are wrapped in `FailedConnectionException`. The direct `xrm:connection` branch uses `CrmConnector` and wraps proxy-creation errors but does not invoke the probe.",
      "evidence": [
        {
          "resource": "repo://src/dgt.power.common/Logic/XrmConnection.cs#L70-L84",
