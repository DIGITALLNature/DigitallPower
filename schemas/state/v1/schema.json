{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dgtp application state",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "installId": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "default": null
        }
      }
    },
    "updates": {
      "type": "object",
      "properties": {
        "lastCheckOn": { "type": ["string", "null"], "format": "date-time", "default": null }
      }
    }
  }
}
